{
  "name": "etos-expo-chat",
  "version": "0.1.0",
  "private": true,
  "expo": {
    "autolinking": {
      "ios": {
        "buildFromSource": ["expo-modules-core"]
      }
    }
  },
  "main": "index.js",
  "scripts": {
    "postinstall": "node scripts/patch-enriched-markdown.mjs",
    "start": "expo start --localhost --port 8081",
    "web": "node scripts/dev-seed.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "node tests/ui-browser.cjs",
    "test:ui:host": "tsx tests/fixtures/start-ui-host.ts",
    "test:seed": "tsx --test tests/seed-proxy.test.ts",
    "dev": "expo start --dev-client --lan --port 8081",
    "ios:prepare": "tsx scripts/ios-cli.ts prepare",
    "ios:build": "tsx scripts/ios-cli.ts build",
    "ios:archive": "tsx scripts/ios-cli.ts archive",
    "ios:build:release": "tsx scripts/ios-cli.ts build --configuration Release",
    "ios:install": "tsx scripts/ios-cli.ts install",
    "ios:install:release": "tsx scripts/ios-cli.ts install --configuration Release",
    "ios:install:ack": "tsx scripts/ios-cli.ts acknowledge"
  },
  "dependencies": {
    "@better-auth/core": "1.7.14",
    "@better-auth/passkey": "1.7.14",
    "@earendil-works/chord": "1.0.0",
    "@expo/ui": "~58.0.27",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/flash-list": "2.3.2",
    "better-auth": "1.7.14",
    "better-call": "1.4.4",
    "expo": "~58.0.23",
    "expo-asset": "~58.0.20",
    "expo-audio": "~58.0.11",
    "expo-auth-session": "~58.0.17",
    "expo-clipboard": "~58.0.4",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.22",
    "expo-symbols": "~58.0.4",
    "expo-updates": "~58.0.21",
    "expo-web-browser": "~58.0.7",
    "katex": "0.19.1",
    "marked": "18.0.14",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-enriched-markdown": "1.2.0-nightly-20261109-ca015bcac",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "@types/ws": "8.18.1",
    "tsx": "^4.20.6",
    "typescript": "6.0.3",
    "ws": "8.22.2"
  },
  "type": "module",
  "allowScripts": {
    "react-native-enriched-markdown@1.2.0-nightly-20261109-ca015bcac": true
  },
  "enriched-markdown": {
    "enableMath": true,
    "enableCodeHighlight": true
  }
}
