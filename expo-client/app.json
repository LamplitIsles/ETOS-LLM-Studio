{
  "expo": {
    "name": "ETOS Chat",
    "slug": "etos-expo-chat",
    "version": "2.0.0",
    "scheme": "etosllmstudio",
    "runtimeVersion": { "policy": "fingerprint" },
    "updates": {
      "url": "https://updates.lamplit.run/v1/manifest",
      "fallbackToCacheTimeout": 0,
      "useEmbeddedUpdate": true
    },
    "ios": {
      "bundleIdentifier": "io.guion.etos.cfl4960",
      "appleTeamId": "RL5WAW5828"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "允许选择要发送的照片。",
          "cameraPermission": "允许使用相机拍摄要发送的照片。",
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ]
    ]
  }
}
